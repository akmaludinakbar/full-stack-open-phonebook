# Production/API runtime. Provide a real URI only in a private environment file or host settings.
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/phonebook
PORT=3001

# Optional CLI-only values when MONGODB_URI is not set. mongo.js takes the password argument.
MONGODB_HOST=example.mongodb.net
MONGODB_USER=example-user
MONGODB_DATABASE=phonebook
