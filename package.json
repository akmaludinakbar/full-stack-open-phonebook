{
  "name": "fso-part3-phonebook-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build && node scripts/copy-frontend.js",
    "deploy:build": "npm run build:frontend",
    "demo": "node scripts/local-demo.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mongoose": "9.11.4",
    "morgan": "1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  }
}
